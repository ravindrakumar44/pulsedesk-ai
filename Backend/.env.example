# ==============================================================================
# PulseDesk AI - Backend Environment Variables Template
# ==============================================================================
# Copy this file to Backend/.env (which is gitignored) and fill in your values.
# ASP.NET Core automatically loads Backend/.env on startup via Program.cs.

ASPNETCORE_ENVIRONMENT=Development

# ------------------------------------------------------------------------------
# MySQL Database Connection (Required)
# ------------------------------------------------------------------------------
ConnectionStrings__DefaultConnection="Server=localhost;Port=3306;Database=helpdesk_sentiment_db;User=root;Password=YOUR_MYSQL_PASSWORD;"

# ------------------------------------------------------------------------------
# JWT Authentication (Required - minimum 32 characters for HMAC-SHA256)
# ------------------------------------------------------------------------------
Jwt__Key="REPLACE_WITH_A_STRONG_32_PLUS_CHAR_SECRET_KEY"
Jwt__Issuer="HelpdeskSentimentApi"
Jwt__Audience="HelpdeskSentimentClient"
Jwt__ExpiryMinutes=480

# ------------------------------------------------------------------------------
# Frontend CORS Allowed Origins
# ------------------------------------------------------------------------------
Cors__AllowedOrigins__0="http://localhost:5173"
Cors__AllowedOrigins__1="http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# Initial Admin & Support Agent Seeding (Development / First-Run Setup)
# ------------------------------------------------------------------------------
AdminSeed__FullName="Helpdesk Administrator"
AdminSeed__Email="admin@pulsedesk.local"
AdminSeed__Password="Admin@12345"

AgentSeed__Enabled=true
AgentSeed__Email="agent@pulsedesk.local"
AgentSeed__DefaultPassword="Agent@12345"

# ------------------------------------------------------------------------------
# Sample Demonstration Customers & Complaints
# ------------------------------------------------------------------------------
SeedData__EnableSampleData=true
SeedData__DemoCustomerPassword="Customer@123"
