{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_MONSTER_MYSQL_HOST;Port=3306;Database=YOUR_DB_NAME;User=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;"
  },
  "Database": {
    "MySqlVersion": "8.0.36"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "HelpdeskSentimentApi",
    "Audience": "HelpdeskSentimentClient",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [
      "https://YOUR-SITE-NAME.runasp.net"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "AdminSeed": {
    "FullName": "Helpdesk Administrator",
    "Email": "admin@pulsedesk.local",
    "Password": "CHANGE_ADMIN_PASSWORD"
  },
  "AgentSeed": {
    "Enabled": true,
    "Email": "agent@pulsedesk.local",
    "DefaultPassword": "CHANGE_AGENT_PASSWORD"
  },
  "SeedData": {
    "EnableSampleData": true,
    "DemoCustomerPassword": "Customer@123"
  }
}
